# Local backend environment variables
# Railway will provide DATABASE_URL and PORT automatically when using a PostgreSQL plugin.

# Use this only for local development.
# Leave DATABASE_URL empty when using PG environment variables locally.
DATABASE_URL=

# Local Postgres values (optional if not using DATABASE_URL)
PGUSER=postgres
PGPASSWORD=your_local_db_password
PGHOST=localhost
PGPORT=5432
PGDATABASE=fifa_fantasy

# Secret used to sign JWTs
JWT_SECRET=your_jwt_secret
